<% layout("/layouts/boilerplate") %>

<div class="container py-5 text-center" style="max-width:500px;">
  <div class="error-page">
    <h1 class="error-code"><%= err.status || 500 %></h1>
    <h4 class="mb-3"><%= err.message || "Something went wrong!" %></h4>
    <p class="text-muted">We couldn't find what you were looking for.</p>
    <a href="/listings" class="btn btn-dark mt-3">
      <i class="fa-solid fa-arrow-left me-2"></i>Back to Listings
    </a>
  </div>
</div>
