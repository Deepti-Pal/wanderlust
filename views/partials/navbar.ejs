          <a class="nav-link" href="/listings/new">
            <i class="fa-solid fa-plus-circle me-1"></i>Airbnb your home
          </a>
        </li>

        <% if (!currUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/signup">Sign up</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-dark nav-btn" href="/login">Log in</a>
        </li>
        <% } else { %>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle user-menu"
            href="#"
